{
  "baseBranch": "main",
  "readyLabel": "ready-for-agent",
  "models": {
    "implementation": { "model": "gpt-6.1-sol", "reasoningEffort": "medium" },
    "review": { "model": "gpt-6.1-sol", "reasoningEffort": "high" }
  },
  "verify": [
    ["python3", "scripts/validate-orchestrator.py"]
  ],
  "requiredChecks": ["OneSet validation"],
  "sensitivePaths": [
    ".agents",
    "AGENTS.md",
    "scripts",
    "docs/database",
    "OneSet/Features/Authentication",
    "OneSet/Services/Identity",
    "OneSet/Services/Account",
    "worker/src/authentication.ts",
    "worker/src/cloudflare-access.ts",
    "worker/wrangler.toml",
    "worker/wrangler.jsonc"
  ],
  "workerTimeoutSeconds": 3600,
  "checksTimeoutSeconds": 7200,
  "merge": false
}
